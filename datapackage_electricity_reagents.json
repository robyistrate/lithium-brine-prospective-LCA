{
    "profile": "data-package",
    "name": "electricity_reagents_scenarios",
    "title": "Future environmental performance of lithium from brines shaped by energy and reagent decarbonization and technology optimization",
    "description": "Datapackage that implements electricity mixes for Argentina, Bolivia, and Chile based on national energy plans and future changes in the production of reagents used in lithium processing.",
    "source": "xxxxxxx",
    "version": "0.0.1",
    "contributors": [
        {
            "title": "Robert Istrate",
            "email": "i.r.istrate@cml.leidenuniv.nl"
        }
    ],
    "dependencies": {
        "premise": ">=2.2.0"
    },
    "ecoinvent": {
        "version": "3.10",
        "system model": "cut-off"
    },
    "scenarios": {
        "NationalPlans": [
            {
                "model": "remind",
                "pathway": "SSP2-NDC"
            }
        ]
    },
    "licenses": [
        {
            "id": "CC0-1.0",
            "title": "CC0 1.0",
            "url": "https://creativecommons.org/publicdomain/zero/1.0/"
        }
    ],
    "resources": [
        {
            "path": "scenario_data/scenario_data_electricity_reagents.csv",
            "profile": "tabular-data-resource",
            "name": "scenario_data",
            "format": "csv",
            "mediatype": "text/csv",
            "encoding": "utf-8-sig",
            "schema": {
                "fields": [
                    {
                        "name": "scenario",
                        "type": "string",
                        "format": "default"
                    },
                    {
                        "name": "region",
                        "type": "string",
                        "format": "default"
                    },
                    {
                        "name": "variables",
                        "type": "string",
                        "format": "default"
                    },
                    {
                        "name": "unit",
                        "type": "string",
                        "format": "default"
                    },
                    {
                        "name": "2025",
                        "type": "number",
                        "format": "default"
                    },
                    {
                        "name": "2035",
                        "type": "number",
                        "format": "default"
                    }
                ],
                "missingValues": [
                    ""
                ]
            }
        },
        {
            "path": "configuration_file/config_electricity_reagents.yaml",
            "profile": "data-resource",
            "name": "config",
            "format": "yaml",
            "mediatype": "text/yaml",
            "encoding": "utf-8"
        },
                {
            "path": "inventories/lci-reagents.xlsx",
            "profile": "data-resource",
            "name": "inventories",
            "format": "xlsx",
            "mediatype": "text/csv",
            "encoding": "utf-8",
            "schema": {
                "fields": [
                    {
                        "name": "name",
                        "type": "string",
                        "format": "default"
                    },
                    {
                        "name": "amount",
                        "type": "number",
                        "format": "default"
                    },
                    {
                        "name": "database",
                        "type": "string",
                        "format": "default"
                    },
                    {
                        "name": "location",
                        "type": "string",
                        "format": "default"
                    },
                    {
                        "name": "categories",
                        "type": "string",
                        "format": "default"
                    },
                    {
                        "name": "unit",
                        "type": "string",
                        "format": "default"
                    },
                    {
                        "name": "type",
                        "type": "string",
                        "format": "default"
                    },
                    {
                        "name": "reference product",
                        "type": "string",
                        "format": "default"
                    }
                ],
                "missingValues": [
                    ""
                ]
            }
        }
    ]
}